# Copy to .env for local dev. In production (Railway), set these via the
# project's Variables tab — do NOT commit a real .env.

# Server
NODE_ENV=development              # production on Railway
PORT=3001                         # Railway injects PORT automatically; leave unset there
PUBLIC_ORIGIN=http://localhost:5173

# Where SQLite + uploads live. On Railway, mount a Volume at /data and set DATA_DIR=/data.
# Leave unset locally → defaults to ./server/data and ./server/uploads.
# DATA_DIR=/data

# Secrets — generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-strong-256-bit-random-string

# Initial admin account (seeded once on first boot, when the DB is empty)
ADMIN_EMAIL=admin@feedyourhead.fr
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# Formulaire de contact → envoi via SMTP (boîte IONOS de Virginie).
# Sans ces variables, le formulaire répond "email_not_configured".
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587                      # 587 (STARTTLS) ou 465 (SSL)
SMTP_USER=virginie@feedyourhead.fr
SMTP_PASS=le-mot-de-passe-de-la-boite
# Destinataire des messages (par défaut = SMTP_USER)
# CONTACT_TO=virginie@feedyourhead.fr
